{
  "name": "cavalry-mcp",
  "version": "0.2.0",
  "description": "MCP server giving AI assistants searchable, section-level access to the Cavalry documentation, plus a script checker.",
  "type": "module",
  "bin": {
    "cavalry-mcp": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "check": "node dist/src/index.js --check",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
